<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#203026">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#88D982" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_values" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to refresh" android:textColor="#FFFFFF" android:textSize="13sp" android:paddingTop="8dp" />
</LinearLayout>
